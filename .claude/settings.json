{
  "model": "sonnet",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)", "Bash(npx *)", "Bash(node *)",
      "Bash(git init*)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)",
      "Bash(mkdir *)", "Bash(ls *)", "Bash(cd *)",
      "Bash(./gradlew *)", "Bash(gradlew *)",
      "PowerShell(npm *)", "PowerShell(npx *)", "PowerShell(node *)",
      "PowerShell(git add *)", "PowerShell(git commit *)", "PowerShell(git status*)",
      "PowerShell(cd *)", "PowerShell(./gradlew *)", "PowerShell(.\\gradlew *)"
    ],
    "deny": ["Bash(rm -rf *)", "PowerShell(Remove-Item *)"]
  }
}
